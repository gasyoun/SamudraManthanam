[Unit]
Description=Samudra Manthanam Web (FastAPI / uvicorn)
After=network.target

[Service]
User=samudra
Group=samudra
WorkingDirectory=/opt/samudra/web
EnvironmentFile=/opt/samudra/.env
ExecStart=/opt/samudra/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2
Restart=on-failure
RestartSec=5

# ── Hardening ────────────────────────────────────────────────────────────────
# The app needs to read /opt/samudra/{web,venv,corpus} and write to
# /opt/samudra/{db,state.db,backups}. Everything else is read-only or
# inaccessible. Comment out any line that breaks your specific setup.

# Filesystem
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/samudra
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
# New files the unit creates (state.db WAL, logs) are 600/700 — never 644.
# Live drop-in on prod (H2396): /etc/systemd/system/samudra.service.d/umask.conf
UMask=0077

# Namespaces and network
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=no  # Python's CPython needs JIT-style write+exec at import time
RestrictRealtime=yes

# System calls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
