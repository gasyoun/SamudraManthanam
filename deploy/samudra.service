[Unit]
Description=Samudra Manthanam Web (FastAPI / uvicorn)
After=network.target

[Service]
User=samudra
Group=samudra
WorkingDirectory=/opt/samudra/web
EnvironmentFile=/opt/samudra/.env
ExecStart=/opt/samudra/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2
Restart=on-failure
RestartSec=5
# Prevent the process from writing to the real root filesystem
PrivateTmp=true

[Install]
WantedBy=multi-user.target
