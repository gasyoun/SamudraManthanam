/node_modules
/build
/.docusaurus
~$*
.claude/

# H754 НКРЯ export artifacts: bulk XML/TMX/TSV are in-copyright, gitignored.
# Only PILOT_VALIDATION.md is committed.
# H759 3-path annotation comparison: the per-source annotated TSV bulk stays
# gitignored with the rest; the small Sanskrit-only metrics/sample/report
# artifacts (no Russian translation text) are whitelisted.
/export/*
!/export/PILOT_VALIDATION.md
!/export/ANNOTATION_3PATH_COMPARISON.md
!/export/annotation_3path_metrics.json
!/export/annotation_adjudication_sample.json
# Wave-4 reports + H5281 showcase metadata (no translation text; the showcase
# bulk ships as a GitHub release asset, never committed).
!/export/RIGHTS_TABLE.md
!/export/FULL_CORPUS_VALIDATION.md
!/export/showcase/
/export/showcase/*
!/export/showcase/MANIFEST.tsv
!/export/showcase/SHOWCASE_VALIDATION.md

# H760 sanskritism extraction: per-source lexicon/epithets/index JSON quote
# in-copyright running text (surface forms + verse group ids), gitignored
# like the export artifacts above. Only the corpus-wide counts report is
# committed.
/sanskritisms/*
!/sanskritisms/COUNTS_REPORT.md
